# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used ONLY by scripts/seed-profile.ts (never imported by app code
# that ships to the browser). Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application timezone for computing "local date" boundaries.
APP_TIMEZONE=America/New_York

# The single manually-created account's email, used only by the seed script
# to look up the user id to attach the seeded profile to.
SEED_USER_EMAIL=you@example.com

# Server-only. Reads Garmin summary screenshots into a reviewable draft.
# Never expose this value through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=your-openai-api-key

# Browser push reminders. Generate one VAPID key pair and keep the private
# key server-only. VAPID_SUBJECT should be a mailto: address you control.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Protects the scheduled reminder endpoint. Vercel supplies this value as a
# Bearer token to cron requests after you add the same secret to the project.
CRON_SECRET=use-a-long-random-value
